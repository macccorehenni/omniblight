STYLE_SETTINGS_BODY_CLASSES=mod-macos is-mobile is-ios is-phone obsidian-app theme-light show-inline-title is-floating-nav auto-full-screen show-ribbon show-view-header folder-notes-plugin hide-folder-note folder-note-underline folder-note-underline-path fn-whitespace-stop-collapsing fn-ignore-attachment-folder version-1-7-2 css-settings-manager accented-interface color-scheme-accent tiniri-light contrast-light tiniri-dark contrast-dark layout-cupertino input-cupertino status-bar-cupertino tab-default tab-stack-top view-header-title-hover tab-top-left-stacked tab-left-compact tab-top-right-icon tab-right-compact nav-action-dot nav-item-baseline colorful-folders-side full-item-name bold-folders horizontal-tab-options focus-view mode-switcher-off active-line-side active-line-color-accent table-normal bases-normal img-normal metadata-default metadata-add-property-always colorful-headings-dot colorful-headings-text h1-l blockquote-baseline callouts-default code-default embed-side media-width-full pdf-shadow table-width-full AT-column
